# FR-007 names only. Inject values from deployment secret/config stores.
# Never populate and commit this file. NEXT_PUBLIC_* is browser-visible.

# Database / data plane (api, worker, scheduler, backup)
CLOUD_DATABASE_URL=

# Auth (api); public client key is below
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_SERVICE_KEY=

# Private storage (api, worker)
STORAGE_SERVICE_KEY=
STORAGE_PRIVATE_BUCKET=

# Worker / queue and scheduler
QUEUE_NAMESPACE=
SCHEDULER_DISPATCH_TOKEN=

# Frontend / public (web build; browser-visible)
NEXT_PUBLIC_DATA_API_URL=
NEXT_PUBLIC_DATA_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Monitoring
MONITORING_ERROR_ENDPOINT=
MONITORING_HEARTBEAT_URL=

# Notifications
NOTIFICATION_API_KEY=
NOTIFICATION_FROM_ADDRESS=

# Backup / disaster recovery
BACKUP_DESTINATION_URL=
BACKUP_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
