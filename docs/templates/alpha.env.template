# Template for the founder-alpha local runner (scripts/alpha.py).
#
# Copy this file to private/alpha.env and replace every placeholder below
# with a real value. private/ is listed in .gitignore (see ".gitignore":
# "private/*") so private/alpha.env is never committed and never reaches
# the public docs mirror -- only this template (under docs/, which is on
# the public mirror allowlist) is published. Do not put a real password,
# session secret, or database credential in any file under docs/.
#
# scripts/alpha.py reads exactly these three keys, in KEY=VALUE form (no
# quoting required; blank lines and lines starting with # are ignored).

# Password for the founder's single local login. Choose your own value --
# this is not sent anywhere external; it only gates the local API/session.
OPPORTUNITYOS_FOUNDER_PASSWORD=REPLACE_WITH_A_LOCAL_FOUNDER_PASSWORD

# Random secret used to sign local session cookies. Generate one yourself,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
OPPORTUNITYOS_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SESSION_SECRET

# PostgreSQL connection string for the local alpha database. Point this at
# either an already-running local PostgreSQL server or the portable cluster
# under %LOCALAPPDATA%\opos-pg\ (see briefs/BRIEF-FR-003.md section 6).
#
# The database name must be opportunityos_alpha, not REPLACE_WITH_DB_NAME --
# alpha.py creates opportunityos_alpha automatically if it does not already
# exist, and refuses outright (exits non-zero, naming the database) to start
# against any database whose name ends in "_test". A database ending
# "_test" is the automated test suite's own database, populated with
# synthetic fixtures; BRIEF-FR-005 D4 exists precisely because an earlier
# alpha.py session once attached to it and served those fixtures to the
# founder as though they were real (see the erratum in
# reports/REPORT-FR-004.md). Do not repoint this at opportunityos_test or
# any other database ending "_test".
OPPORTUNITYOS_DB_URL=postgresql+psycopg2://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/opportunityos_alpha
