# Copy to .env.local (gitignored) and adjust for your machine.

# Phase 1 (this brief): 1 = serve the feed from the in-browser MSW mock
# layer (lib/mock/), with no real backend required.
# Phase 2: set to 0 (or remove) once the FastAPI service (D6) is running
# at localhost:8000 and the Next rewrite in next.config.ts is proxying to
# it. No other file changes are required to switch.
NEXT_PUBLIC_USE_MOCK_API=1
